APP_NAME=Midad
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8391

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=midad
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Africa/Cairo
FRONTEND_URL=http://localhost:5391
SANCTUM_STATEFUL_DOMAINS=localhost:5391,127.0.0.1:5391,localhost:8391

# Paymob (direct HTTP, no SDK) — sandbox values go in .env only
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_CARD=
PAYMOB_INTEGRATION_WALLET=

SEED_ADMIN_EMAIL=admin@midad.local
SEED_ADMIN_PASSWORD=

PAYMENT_DRIVER=fake

# ── Production (INT-02) ──────────────────────────────────────────────
# Storefront, API and admin share ONE origin (Laravel serves the built SPA),
# so no CORS is needed and cookies stay first-party.
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://midad.example
# FRONTEND_URL=https://midad.example
# SANCTUM_STATEFUL_DOMAINS=midad.example,www.midad.example
# SESSION_DOMAIN=null            # host-only cookie; set .midad.example only if www and apex both serve the app
# SESSION_SECURE_COOKIE=true     # session, XSRF and cart cookies HTTPS-only
# SESSION_SAME_SITE=lax          # lax keeps the session on the return from Paymob's checkout
# SESSION_ENCRYPT=true
# LOG_LEVEL=warning
# MAIL_MAILER=smtp
# PAYMENT_DRIVER=paymob
