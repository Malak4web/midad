    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^26.1.0",
    "pngjs": "^7.0.0",
    "potrace": "^2.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
